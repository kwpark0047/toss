# 프로덕션 빌드 시 Vite가 자동 주입 (npm run build)
# VITE_API_URL/VITE_SOCKET_URL를 지정하면 브라우저가 Render 백엔드로 직접 호출한다.
# 지정하지 않으면 same-origin /api 폴백을 사용하며,
# Cloudflare Worker의 /api 프록시(frontend/worker.js)가 백엔드로 전달한다.
# VITE_API_URL=https://wemarket-toss.onrender.com/api
VITE_API_URL=https://wemarket.onrender.com/api
VITE_SOCKET_URL=https://wemarket.onrender.com
