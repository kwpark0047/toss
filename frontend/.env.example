# 프론트엔드 환경변수 예시 — 복사해 .env.local 또는 .env.production으로 사용
# 백엔드 API 베이스 URL (개발: http://localhost:3000/api)
VITE_API_URL=https://wemarket-toss.onrender.com/api

# Firebase Cloud Messaging (고객 주문 알림 푸시)
# VAPID 키가 있어야 QR 주문 페이지에서 FCM 토큰을 발급받아 푸시 알림을 보낼 수 있음
# Firebase 콘솔 > 프로젝트 설정 > Cloud Messaging > 웹 푸시 인증서에서 발급
VITE_FIREBASE_VAPID_KEY=
# (선택) 서버 /api/config/firebase 미가용 시 폴백용
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
