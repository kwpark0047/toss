{
  "dashboard": {
    "title": "WeMarket - System Overview",
    "tags": ["wemarket", "overview", "production"],
    "timezone": "utc",
    "panels": [
      {
        "id": 1,
        "title": "HTTP Request Rate",
        "type": "graph",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{job=\"wemarket-api\"}[5m])) by (method, status)",
            "legendFormat": "{{method}} {{status}}"
          }
        ]
      },
      {
        "id": 2,
        "title": "HTTP Latency (P50/P95/P99)",
        "type": "graph",
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"wemarket-api\"}[5m])) by (le))",
            "legendFormat": "P50"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"wemarket-api\"}[5m])) by (le))",
            "legendFormat": "P95"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"wemarket-api\"}[5m])) by (le))",
            "legendFormat": "P99"
          }
        ]
      },
      {
        "id": 3,
        "title": "Error Rate",
        "type": "graph",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{job=\"wemarket-api\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"wemarket-api\"}[5m]))",
            "legendFormat": "Error Rate"
          }
        ]
      },
      {
        "id": 4,
        "title": "Active Connections",
        "type": "graph",
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(http_requests_total{job=\"wemarket-api\"})",
            "legendFormat": "Total Requests"
          }
        ]
      },
      {
        "id": 5,
        "title": "AI Requests Rate",
        "type": "graph",
        "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(ai_requests_total[5m])) by (provider, endpoint)",
            "legendFormat": "{{provider}} - {{endpoint}}"
          }
        ]
      },
      {
        "id": 6,
        "title": "AI Cost (USD/hour)",
        "type": "graph",
        "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(ai_cost_usd_total[1h]) * 3600",
            "legendFormat": "Cost/hour"
          }
        ]
      },
      {
        "id": 7,
        "title": "Cache Hit Rate",
        "type": "gauge",
        "gridPos": {"x": 0, "y": 24, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "sum(rate(cache_hits_total[5m])) / (sum(rate(cache_hits_total[5m])) + sum(rate(cache_misses_total[5m]))) * 100",
            "legendFormat": "Hit Rate %"
          }
        ]
      },
      {
        "id": 8,
        "title": "CPU Usage",
        "type": "gauge",
        "gridPos": {"x": 6, "y": 24, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "avg(1 - rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100",
            "legendFormat": "CPU %"
          }
        ]
      },
      {
        "id": 9,
        "title": "Memory Usage",
        "type": "gauge",
        "gridPos": {"x": 12, "y": 24, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100",
            "legendFormat": "Memory %"
          }
        ]
      },
      {
        "id": 10,
        "title": "Disk Usage",
        "type": "gauge",
        "gridPos": {"x": 18, "y": 24, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "(node_filesystem_size_bytes - node_filesystem_free_bytes) / node_filesystem_size_bytes * 100",
            "legendFormat": "Disk %"
          }
        ]
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "10s"
  }
}
