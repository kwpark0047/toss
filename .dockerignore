# Docker ignore file for WeMarket
# Prevents unnecessary files from being copied into the Docker image

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment
.env
.env.local
.env.production
.env.development

# Build outputs
dist/
build/
frontend/dist/
frontend/dev-dist/
coverage/

# Testing
test-results/
playwright-report/
.nyc_output/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Docker
Dockerfile
docker-compose*.yml

# CI/CD
.github/
.vercel/
.wrangler/

# Logs
logs/
*.log

# Prisma
prisma/*.db
prisma/*.db-journal

# Misc
.agents/
.omo/
