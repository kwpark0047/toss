{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "strict": true,
    "allowJs": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "utils/**/*.ts",
    "services/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "frontend",
    "playwright-report",
    "test-results"
  ]
}
