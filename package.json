{
  "name": "wemarket-api",
  "version": "1.1.0",
  "description": "WeMarket QR Menu Platform API",
  "main": "index.js",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "start": "node index.js",
    "build": "npx prisma generate && cd frontend && npm install --legacy-peer-deps && npm run build",
    "cloudflare-build": "cd frontend && npm install && npm run build",
    "db:push": "node scripts/guard-db-push.js && npx prisma db push",
    "db:push:force": "node scripts/guard-db-push.js && npx prisma db push --accept-data-loss",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:prod": "npx prisma migrate deploy",
    "db:migrate:baseline": "npx prisma migrate resolve --applied 20260101000000_baseline",
    "db:drift": "npx prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --script",
    "db:status": "npx prisma migrate status",
    "validate:routes": "node scripts/validate-routes.js",
    "postinstall": "node -e \"if(!process.env.VERCEL && !process.env.CF_PAGES){require('child_process').execSync('prisma generate',{stdio:'inherit'})}\"",
    "seed": "node scripts/seed_production_direct.js",
    "test": "jest --config jest.config.js tests/unit tests/routes --coverage",
    "test:unit": "jest --config jest.config.js tests/unit tests/routes",
    "test:routes": "jest --config jest.config.js tests/routes",
    "test:integration": "jest --config jest.config.js tests/integration",
    "test:regression": "jest --config jest.config.js tests/regression",
    "test:watch": "jest --config jest.config.js --watch",
    "test:coverage": "jest --config jest.config.js tests/unit tests/routes --coverage --coverageReporters=text --coverageReporters=text-summary --coverageReporters=lcov",
    "test:coverage:c8": "c8 --reporter=text --reporter=lcov --all --include='routes/' --include='models/' --include='services/' --include='utils/' jest --config jest.config.js --detectOpenHandles",
    "test:e2e": "npx playwright test",
    "test:e2e:chrome": "npx playwright test --project=chromium-desktop",
    "test:e2e:mobile": "npx playwright test --project=mobile-chrome --project=mobile-safari",
    "test:e2e:legacy": "npx playwright test --project=android-legacy",
    "test:e2e:animation": "npx playwright test --project=low-spec-desktop tests/e2e/animation-fallback.spec.js",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:report": "npx playwright show-report playwright-report",
    "lint": "eslint .",
    "lint:backend": "eslint .",
    "security:scan": "semgrep --config p/javascript --config p/nodejs --config p/secrets --config p/owasp-top-ten --exclude node_modules --exclude dist --exclude frontend/dist --exclude tests routes services middleware controllers utils models config app.js index.js",
    "security:scan:frontend": "semgrep --config p/react --config p/secrets --exclude node_modules --exclude dist frontend/src",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "wemarket",
    "qr-menu",
    "pos"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@sentry/node": "^10.67.0",
    "@supabase/supabase-js": "^2.90.1",
    "awilix": "^13.0.5",
    "axios": "^1.16.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.1.0",
    "iconv-lite": "^0.7.3",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "node-cache": "^5.1.2",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.19.1",
    "proj4": "^2.20.9",
    "qr-code-styling": "^1.9.2",
    "qrcode": "^1.5.4",
    "redis": "^4.7.1",
    "sanitize-html": "^2.17.6",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
  },
  "overrides": {
    "protobufjs": "^7.6.3",
    "ws": "^8.21.0",
    "flatted": "^3.4.1",
    "picomatch": "^4.0.4",
    "tmp": "^0.2.6",
    "uuid": "^11.1.0",
    "brace-expansion": "^5.0.8",
    "fast-xml-parser": "^5.3.4",
    "js-yaml": "^4.1.1",
    "body-parser": "^2.2.1",
    "archiver": "^7.0.1",
    "archiver-utils": "^5.0.2",
    "zip-stream": "^6.0.1",
    "readdir-glob": "^2.0.3"
  },
  "devDependencies": {
    "@babel/preset-env": "^8.0.2",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "^1.58.2",
    "@prisma/client": "^5.22.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "abort-controller": "^3.0.0",
    "domexception": "^4.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.1.0",
    "node-fetch": "^2.7.0",
    "pg": "^8.22.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.5",
    "prisma": "^5.22.0",
    "semgrep": "^0.0.1",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "winston-transport": "^4.9.0"
  }
}
