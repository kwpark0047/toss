generator client {
  provider = "prisma-client-js"
  output   = "app/generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public", "auth"]
}

enum OrderStatus {
  pending
  confirmed
  preparing
  ready
  completed
  cancelled
  @@schema("public")
}

enum OrderPaymentStatus {
  pending
  paid
  partial
  failed
  refunded
  @@schema("public")
}

enum PaymentTxStatus {
  pending
  READY
  DONE
  CANCELED
  PARTIAL_CANCELED
  @@schema("public")
}

model categories {
  id         Int        @id @default(autoincrement())
  store_id   Int
  name       String
  sort_order Int?       @default(0)
  created_at DateTime?  @default(now())
  stores     stores     @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products   products[]

  @@index([store_id, sort_order], map: "idx_categories_store_sort")
  @@schema("public")
}

model comments {
  id          Int       @id @default(autoincrement())
  post_id     Int
  parent_id   Int?
  content     String
  author_id   Int
  author_name String
  created_at  DateTime? @default(now())
  users       users     @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  posts       posts     @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([parent_id], map: "idx_comments_parent")
  @@index([post_id], map: "idx_comments_post")
  @@schema("public")
}

model ledger {
  id          Int       @id @default(autoincrement())
  store_id    Int
  order_id    Int?
  payment_id  Int?
  type        String
  category    String
  amount      Int
  method      String?
  description String?
  event_key   String?   @unique(map: "uq_ledger_event_key")
  created_at  DateTime? @default(now())
  payments    payments? @relation(fields: [payment_id], references: [id], onUpdate: NoAction)
  orders      orders?   @relation(fields: [order_id], references: [id], onUpdate: NoAction)
  stores      stores    @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([store_id], map: "idx_ledger_store")
  @@schema("public")
}

model metrics {
  id            Int       @id @default(autoincrement())
  endpoint      String?
  method        String?
  response_time Int?
  status_code   Int?
  store_id      Int?
  user_id       Int?
  timestamp     DateTime? @default(now())
  @@schema("public")
}

model order_items {
  id           Int       @id @default(autoincrement())
  order_id     Int
  product_id   Int?
  product_name String
  price        Int
  quantity     Int
  subtotal     Int
  options      String?
  user_phone   String?   // [추가] 해당 품목을 주문한 사람의 전화번호 (분할 결제 정산용)
  created_at   DateTime? @default(now())
  products     products? @relation(fields: [product_id], references: [id], onUpdate: NoAction)
  orders       orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([order_id], map: "idx_order_items_order_id")
  @@index([product_id], map: "idx_order_items_product_id")
  @@schema("public")
}

model orders {
  id                 Int                  @id @default(autoincrement())
  store_id           Int
  table_id           Int?
  order_number       String               @unique
  customer_name      String?
  customer_phone     String?
  customer_fcm_token String?
  notes              String?
  status             OrderStatus?         @default(pending)
  method             String?
  payment_status     OrderPaymentStatus?   @default(pending)
  total_amount       Int?                 @default(0)
  queue_number       Int?
  estimated_minutes  Int?
  created_at         DateTime?            @default(now())
  toss_user_key      String?
  updated_at         DateTime?
  completed_at       DateTime?
  is_takeout         Int?                 @default(0)
  order_type         String?              @default("dine_in")  // dine_in | takeout | delivery
  delivery_address   String?
  preparing_at       DateTime?
  ready_at           DateTime?
  split_type         String?              @default("NONE")     // [추가] 분할 방식 (NONE, EQUAL: N분의 1, ITEM: 품목별)
  is_split_payment   Boolean?             @default(false)    // [추가] 분할 결제 여부
  split_status       String?              @default("PENDING")
  handled_by_staff_id Int?
  staff              staff?               @relation(fields: [handled_by_staff_id], references: [id], onUpdate: NoAction)
  ledger             ledger[]
  order_items        order_items[]
  tables             tables?              @relation(fields: [table_id], references: [id], onUpdate: NoAction)
  stores             stores               @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payments           payments[]
  point_transactions point_transactions[]
  reviews            reviews?
  print_jobs         print_jobs[]

  @@index([created_at], map: "idx_orders_created_at")
  @@index([store_id], map: "idx_orders_store_id")
  @@index([store_id, status, created_at], map: "idx_orders_store_status_date")
  @@index([customer_phone], map: "idx_orders_customer_phone")
  @@index([table_id], map: "idx_orders_table_id")
  @@schema("public")
}

model payments {
  id                    Int                  @id @default(autoincrement())
  order_id              Int
  store_id              Int
  status                PaymentTxStatus      @default(pending)
  amount                Int
  point_amount          Int?                 @default(0)
  cash_amount           Int?                 @default(0)
  toss_pay_token        String?
  payment_key           String?
  toss_transaction_id   String?              @unique(map: "payments_toss_transaction_id_key")
  transfer_confirmed    Boolean?             @default(false)
  transfer_confirmed_at DateTime?
  transfer_reference    String?
  points_earned         Int?                 @default(0)
  error_code            String?
  error_message         String?
  created_at            DateTime?            @default(now())
  updated_at            DateTime?            @default(now())
  completed_at          DateTime?
  cancelled_at          DateTime?
  order_name            String?
  method                String?
  receipt_url           String?
  checkout_url          String?
  card_company          String?
  card_number           String?
  installment_months    Int?                 @default(0)
  easy_pay_provider     String?
  failure_code          String?
  failure_message       String?
  raw_response          String?
  payer_phone           String?              // [추가] 실제 결제을 진행한 사람의 전화번호
  is_partial            Boolean?             @default(false) // [추가] 부분 결제 여부
  approved_at           DateTime?
  cancel_reason         String?
  ledger                ledger[]
  stores                stores               @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders                orders               @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  point_transactions    point_transactions[]

  @@index([payment_key], map: "idx_payments_payment_key")
  @@index([store_id], map: "idx_payments_store_id")
  @@index([order_id], map: "idx_payments_order_id")
  @@index([status], map: "idx_payments_status")
  @@index([store_id, status, created_at], map: "idx_payments_store_status_date")
  @@schema("public")
}

model plan_requests {
  id                                     Int       @id @default(autoincrement())
  store_id                               Int
  user_id                                Int
  current_plan                           String    @default("free")
  requested_plan                         String
  status                                 String    @default("pending")
  reason                                 String?
  admin_note                             String?
  reviewed_by                            Int?
  created_at                             DateTime? @default(now())
  reviewed_at                            DateTime?
  users_plan_requests_reviewed_byTousers users?    @relation("plan_requests_reviewed_byTousers", fields: [reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_plan_requests_user_idTousers     users     @relation("plan_requests_user_idTousers", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stores                                 stores    @relation(fields: [store_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status], map: "idx_plan_requests_status")
  @@index([store_id], map: "idx_plan_requests_store")
  @@schema("public")
}

model Plan {
  id                String   @id @default(cuid())
  name              String   @unique  // free, pro, enterprise
  display_name      String
  description       String?
  price_monthly     Int      @default(0)
  price_yearly      Int      @default(0)
  features          Json     // { maxMenus, maxStaff, aiRecommendations, etc. }
  limits            Json?    // { menuItems: 100, staff: 5, apiCalls: 10000 }
  is_active         Boolean  @default(true)
  sort_order        Int      @default(0)
  trial_days        Int      @default(0)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  subscriptions     Subscription[]
  @@index([is_active], map: "idx_plan_active")
  @@schema("public")
}

model Subscription {
  id                String   @id @default(cuid())
  store_id          Int      @unique(map: "uq_subscription_store")
  plan_id           String
  status            String   @default("active") // active|trialing|past_due|canceled|expired
  billing_cycle     String   @default("MONTHLY") // MONTHLY|YEARLY
  current_period_start DateTime  @default(now())
  current_period_end   DateTime
  trial_ends_at         DateTime?
  cancel_at             DateTime?
  canceled_at           DateTime?
  payment_method_id     String?   // Toss billingKey
  last_payment_at       DateTime?
  next_payment_at       DateTime?
  metadata              Json?     // Toss subscription info
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  plan                  Plan      @relation(fields: [plan_id], references: [id])
  store                 stores    @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([status], map: "idx_subscription_status")
  @@index([plan_id], map: "idx_subscription_plan")
  @@schema("public")
}

model point_transactions {
  id            Int         @id @default(autoincrement())
  user_point_id Int
  store_id      Int
  order_id      Int?
  payment_id    Int?
  type          String
  amount        Int
  balance_after Int
  description   String?
  reference_id  String?
  expires_at    DateTime?
  created_at    DateTime?   @default(now())
  payments      payments?   @relation(fields: [payment_id], references: [id], onUpdate: NoAction)
  orders        orders?     @relation(fields: [order_id], references: [id], onUpdate: NoAction)
  stores        stores      @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_points   user_points @relation(fields: [user_point_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([store_id], map: "idx_point_transactions_store")
  @@index([user_point_id], map: "idx_point_transactions_user")
  @@schema("public")
}

model posts {
  id            Int          @id @default(autoincrement())
  board_type    String       @default("free")
  title         String
  content       String
  author_id     Int
  author_name   String
  is_pinned     Boolean?     @default(false)
  view_count    Int?         @default(0)
  comment_count Int?         @default(0)
  like_count    Int?         @default(0)
  tags          String?      @default("")
  created_at    DateTime?    @default(now())
  updated_at    DateTime?    @default(now())
  comments      comments[]
  post_likes    post_likes[]
  users         users        @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([is_pinned], map: "idx_posts_pinned")
  @@index([author_id], map: "idx_posts_author")
  @@index([board_type], map: "idx_posts_board_type")
  @@schema("public")
}

model post_likes {
  id         Int      @id @default(autoincrement())
  post_id    Int
  user_id    Int
  created_at DateTime @default(now())
  posts      posts    @relation(fields: [post_id], references: [id], onDelete: Cascade)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([post_id, user_id])
  @@index([post_id], map: "idx_post_likes_post")
  @@schema("public")
}

model products {
  id                 Int                 @id @default(autoincrement())
  store_id           Int
  category_id        Int?
  name               String
  description        String?
  price              Int
  image_url          String?
  is_active          Boolean?            @default(true)
  is_sold_out        Boolean?            @default(false)
  sort_order         Int?                @default(0)
  created_at         DateTime?           @default(now())
  detail_description String?
  options            String?
  nutrition_info     String?
  allergens          String?
  ingredients        String?
  spicy_level        Int?                @default(0)
  is_popular         Int?                @default(0)
  is_new             Int?                @default(0)
  tags               String?
  detail_images          String?
  cooking_time           Int?                @default(5)
  updated_at             DateTime?
  stock_quantity         Int?                // null = 무제한, 0 이상 = 수량 관리
  low_stock_threshold    Int                 @default(5)
  order_items            order_items[]
  stores                 stores              @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  categories             categories?         @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  shared_cart_items      shared_cart_items[]
  stock_history          stock_history[]
  demand_forecasts       demand_forecasts[]
  dynamic_pricing_rules   dynamic_pricing_rules[]
  dynamic_price_logs      dynamic_price_logs[]

  @@index([store_id, category_id, is_active], map: "idx_products_store_category_active")
  @@schema("public")
}

model stock_history {
  id           Int       @id @default(autoincrement())
  product_id   Int
  store_id     Int
  change       Int       // 양수 = 입고, 음수 = 차감
  qty_after    Int
  reason       String    // ORDER | MANUAL_IN | MANUAL_OUT | CORRECTION | RETURN
  order_id     Int?
  note         String?
  created_by   Int?      // user_id of staff who made the change
  created_at   DateTime  @default(now())
  products     products  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id], map: "idx_stock_history_product")
  @@index([store_id, created_at(sort: Desc)], map: "idx_stock_history_store_time")
  @@schema("public")
}

model settlements {
  id                          Int       @id @default(autoincrement())
  store_id                    Int
  period_start                DateTime
  period_end                  DateTime
  total_sales                 Int?      @default(0)
  total_refunds               Int?      @default(0)
  commission_ex_vat           Int?      @default(0)  // 수수료(공급가액, 부가세 제외)
  commission_vat              Int?      @default(0)  // 수수료 부가세 (10%)
  commission_amount           Int?      @default(0)  // 수수료 합계(공급가+부가세)
  vat_amount                  Int?      @default(0)  // 레거시 호환 (commission_vat와 동일)
  net_amount                  Int?      @default(0)  // 점주 최종 수취액
  commission_rate_snapshot    Float?                 // 정산 당시 수수료율 스냅샷
  vat_rate_snapshot           Float?    @default(0.10)
  tax_invoice_number          String?                // 세금계산서 번호 (YYYYMMDDsid-seq)
  tax_invoice_issued_at       DateTime?              // 세금계산서 발행일시
  payment_method_breakdown    String?                // JSON: {cash, store_card, transfer, kakao, naver, toss}
  status                      String?   @default("PENDING")  // PENDING|COMPLETED|PAID|CANCELLED
  paid_at                     DateTime?
  created_at                  DateTime? @default(now())
  stores                      stores    @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([store_id], map: "idx_settlements_store")
  @@schema("public")
}

model staff {
  id               Int                @id @default(autoincrement())
  store_id         Int
  user_id          Int
  role             String?            @default("staff")
  pin_code         String?
  is_active        Int?               @default(1)
  created_at       DateTime?          @default(now())
  users            users              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stores           stores             @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders           orders[]
  staff_attendance staff_attendance[]
  staff_schedules  staff_schedules[]

  @@unique([store_id, user_id], map: "uk_staff_store_user")
  @@schema("public")
}

model staff_attendance {
  id         Int       @id @default(autoincrement())
  staff_id   Int
  store_id   Int
  clock_in   DateTime  @default(now())
  clock_out  DateTime?
  work_hours Float?
  note       String?
  created_at DateTime? @default(now())
  staff      staff     @relation(fields: [staff_id], references: [id], onDelete: Cascade)
  stores     stores    @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([staff_id, clock_in], map: "idx_attendance_staff_time")
  @@index([store_id, clock_in], map: "idx_attendance_store_time")
  @@schema("public")
}

model staff_account_requests {
  id                                              Int       @id @default(autoincrement())
  store_id                                        Int
  user_id                                         Int
  role                                            String
  count                                           Int?      @default(1)
  status                                          String    @default("pending")
  reason                                          String?
  admin_note                                      String?
  reviewed_by                                     Int?
  created_at                                      DateTime? @default(now())
  reviewed_at                                     DateTime?
  users_staff_account_requests_reviewed_byTousers users?    @relation("staff_account_requests_reviewed_byTousers", fields: [reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_staff_account_requests_user_idTousers     users     @relation("staff_account_requests_user_idTousers", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stores                                          stores    @relation(fields: [store_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status], map: "idx_staff_requests_status")
  @@index([store_id], map: "idx_staff_requests_store")
  @@schema("public")
}

model store_accounts {
  id              Int       @id @default(autoincrement())
  store_id        Int       @unique(map: "uq_store_accounts_store")
  bank_code       String
  bank_name       String
  account_number  String
  account_holder  String
  toss_account_id String?
  is_active       Boolean?  @default(true)
  created_at      DateTime? @default(now())
  updated_at      DateTime? @default(now())
  stores          stores    @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@schema("public")
}

model store_point_settings {
  id              Int       @id @default(autoincrement())
  store_id        Int       @unique(map: "uq_store_point_settings_store")
  is_enabled      Boolean?  @default(true)
  earn_rate       Float?    @default(1.0)
  min_earn_amount Int?      @default(1000)
  max_use_rate    Float?    @default(100)
  min_use_points  Int?      @default(100)
  expiry_days     Int?      @default(365)
  created_at      DateTime? @default(now())
  updated_at      DateTime? @default(now())
  stores          stores    @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@schema("public")
}

model store_receipt_settings {
  id                 Int       @id @default(autoincrement())
  store_id           Int       @unique(map: "uq_store_receipt_settings_store")
  header_logo        String?
  title              String?   @default("영수증")
  greetings          String?   @default("방문해 주셔서 감사합니다.")
  footer_text        String?   @default("교환/환불은 영수증 지참 시 7일 이내 가능합니다.")
  show_order_number  Boolean?  @default(true)
  show_item_details  Boolean?  @default(true)
  show_store_address Boolean?  @default(true)
  show_points        Boolean?  @default(true)
  updated_at         DateTime? @default(now())
  stores             stores    @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@schema("public")
}

model stores {
  id                       Int                      @id @default(autoincrement())
  user_id                  Int
  name                     String
  description              String?
  address                  String?
  phone                    String?
  theme                    String?
  is_active                Boolean?                 @default(true)
  can_send_sms             Boolean                  @default(false)
  created_at               DateTime?                @default(now())
  business_type            String?
  open_time                String?
  close_time               String?
  business_hours           String?                  // 요일별 영업시간 JSON
  latitude                 Float?
  longitude                Float?
  plan                     String?                  @default("free")
  // ── 구독/멤버십 ────────────────────────────────────
  subscription_id          String?                  @unique(map: "uq_stores_subscription_id")
  billing_cycle            String?                  @default("MONTHLY")     // MONTHLY|YEARLY
  trial_ends_at            DateTime?
  plan_expires_at          DateTime?
  auto_renew               Boolean?                 @default(true)
  payment_method_id        String?                  // Toss brandpay billingKey
  last_payment_at          DateTime?
  next_payment_at          DateTime?
  // ── 사업자 정보 ──────────────────────────────────
  business_number          String?                  // 사업자등록번호 (000-00-00000)
  business_name            String?                  // 법인명/상호명
  ceo_name                 String?                  // 대표자명
  tax_invoice_email        String?                  // 세금계산서 수신 이메일
  // ── 법적 의무 정보 (전자상거래법·통신판매업) ──────────
  mail_order_number        String?                  // 통신판매업신고번호
  business_address         String?                  // 사업장 소재지 (도로명)
  customer_service_phone   String?                  // 고객센터 전화번호
  customer_service_email   String?                  // 고객센터 이메일
  pg_company               String?                  @default("토스페이먼츠") // PG사명
  pg_business_number       String?                  @default("214-88-00591")  // PG사 사업자번호
  // ── 고객 동의 문서 (자유 텍스트 또는 마크다운) ─────────
  terms_of_service         String?                  // 이용약관
  privacy_policy           String?                  // 개인정보처리방침
  refund_policy            String?                  // 환불·취소 정책
  // ── 정산 설정 ────────────────────────────────────
  settlement_cycle         String?                  @default("MONTHLY") // DAILY|WEEKLY|MONTHLY|MANUAL
  commission_rate          Float?                   @default(0.03)      // 플랫폼 수수료율 (기본 3%)
  vat_rate                 Float?                   @default(0.10)      // 부가세율 (법정 10%)
  // ── 활성 결제수단 (JSON 배열) ─────────────────────
  enabled_payment_methods  String?                  @default("[\"cash\",\"store_card\",\"transfer\"]")
  // ── 친환경 뱃지 ────────────────────────────────────
  eco_badge_level          String?                  @default("GREEN_BEGINNER") // GREEN_BEGINNER|ECO_FRIENDLY|ECO_PRO|ECO_MASTER
  eco_badge_title          String?                  @default("그린 파트너 🌿")
  eco_carbon_saved_kg      Float?                   @default(0)
  eco_orders_count         Int?                     @default(0)
  @@index([is_active], map: "idx_stores_is_active")
  @@index([business_type], map: "idx_stores_business_type")
  campaign_settings      campaign_settings[]
  categories             categories[]
  chat_rooms             chat_rooms[]
  coupons                coupons[]
  ledger                 ledger[]
  orders                 orders[]
  payments               payments[]
  option_templates       option_templates[]
  plan_requests          plan_requests[]
  point_transactions     point_transactions[]
  products               products[]
  reservations           reservations[]
  notifications          notifications[]
  notification_templates notification_templates[]
  reviews                reviews[]
  settlements            settlements[]
  staff                  staff[]
  staff_attendance       staff_attendance[]
  staff_account_requests staff_account_requests[]
  store_accounts         store_accounts?
  store_customers        store_customers[]
  store_point_settings   store_point_settings?
  store_receipt_settings store_receipt_settings?
  store_tier_settings    store_tier_settings[]
  users                  users                    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tables                 tables[]
  waiting_list           waiting_list[]
  community_posts        community_posts[]
  store_partnerships_as_requester store_partnerships[] @relation("partnerships_requester")
  store_partnerships_as_target    store_partnerships[] @relation("partnerships_target")
  api_keys                api_keys[]
  webhook_endpoints       webhook_endpoints[]
  print_jobs              print_jobs[]
  store_favorites         store_favorites[]
  staff_schedules         staff_schedules[]
  food_trucks             food_trucks?
  competitor_prices       competitor_prices[]
  pricing_optimization_jobs pricing_optimization_jobs[]
  demand_forecasts        demand_forecasts[]
  dynamic_pricing_rules   dynamic_pricing_rules[]
  dynamic_price_logs      dynamic_price_logs[]
  customer_segments       customer_segments[]
  customer_personalizations customer_personalizations[]
  ai_recommendations      ai_recommendations[]
  personalization_analytics personalization_analytics[]
  grant_templates         grant_templates[]
  grant_change_logs       grant_change_logs[]
  point_grant_history     point_grant_history[]
  coupon_issue_history    coupon_issue_history[]
  subscription            Subscription?

  @@index([user_id], map: "idx_stores_user_id")
  @@schema("public")
}

model notifications {
  id         Int       @id @default(autoincrement())
  store_id   Int
  type       String    // NEW_ORDER | ORDER_STATUS | LOW_STOCK | NEW_REVIEW | NEW_RESERVATION | NEW_WAITING | MANAGER_CALL | SETTLEMENT | SYSTEM
  title      String
  message    String
  data       String?   // JSON 직렬화 추가 정보
  is_read    Boolean   @default(false)
  priority   String    @default("normal") // low | normal | high | urgent
  link       String?   // 클릭 시 이동할 프론트엔드 경로
  created_at DateTime  @default(now())
  stores     stores    @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([store_id, is_read], map: "idx_notifications_store_read")
  @@index([store_id, created_at(sort: Desc)], map: "idx_notifications_store_time")
  @@schema("public")
}

model tables {
  id                Int                 @id @default(autoincrement())
  store_id          Int
  table_number      String
  qr_code           String              @unique(map: "uq_tables_qr_code")
  is_active         Boolean?            @default(true)
  created_at        DateTime?           @default(now())
  capacity          Int?                @default(2)
  updated_at        DateTime?           @default(now())
  status            String?             @default("available")
  x                 Int?                @default(0)
  y                 Int?                @default(0)
  orders            orders[]
  shared_cart_items shared_cart_items[]
  stores            stores              @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@schema("public")
}

model user_points {
  id                 Int                  @id @default(autoincrement())
  user_id            Int?
  toss_user_key      String?              @unique(map: "uq_user_points_toss_key")
  phone              String?
  total_points       Int?                 @default(0)
  lifetime_earned    Int?                 @default(0)
  lifetime_used      Int?                 @default(0)
  created_at         DateTime?            @default(now())
  updated_at         DateTime?            @default(now())
  point_transactions point_transactions[]
  users              users?               @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([phone], map: "idx_user_points_phone")
  @@index([toss_user_key], map: "idx_user_points_toss_key")
  @@schema("public")
}

model users {
  id                                                               Int                      @id @default(autoincrement())
  name                                                             String?
  email                                                            String?                  @unique(map: "uq_users_email")
  phone                                                            String?                  @unique(map: "uq_users_phone")
  address                                                          String?
  profile_step                                                     Int?                     @default(1)
  password                                                         String
  two_factor_enabled                                               Boolean                  @default(false)
  created_at                                                       DateTime?                @default(now())
  role                                                             String?                  @default("user")
  fcm_token                                                        String?
  comments                                                         comments[]
  post_likes                                                       post_likes[]
  plan_requests_plan_requests_reviewed_byTousers                   plan_requests[]          @relation("plan_requests_reviewed_byTousers")
  plan_requests_plan_requests_user_idTousers                       plan_requests[]          @relation("plan_requests_user_idTousers")
  posts                                                            posts[]
  staff                                                            staff[]
  staff_account_requests_staff_account_requests_reviewed_byTousers staff_account_requests[] @relation("staff_account_requests_reviewed_byTousers")
  staff_account_requests_staff_account_requests_user_idTousers     staff_account_requests[] @relation("staff_account_requests_user_idTousers")
  stores                                                           stores[]
  user_points                                                      user_points[]
  community_post_likes                                             community_post_likes[]
  chat_rooms                                                       chat_rooms[]
  social_accounts                                                  social_accounts[]
  admin_otps                                                       admin_otps[]
  point_grant_history                                              point_grant_history[]
  coupon_issue_history                                             coupon_issue_history[]
  grant_change_logs                                                grant_change_logs[]

  @@index([email], map: "idx_users_email")
  @@schema("public")
}

model community_posts {
  id          Int                    @id @default(autoincrement())
  store_id    Int
  type        String                 @default("NEWS")  // EVENT | PROMOTION | NEWS | PRODUCT
  title       String
  content     String
  image_url   String?
  district    String?
  expires_at  DateTime?
  like_count  Int                    @default(0)
  view_count  Int                    @default(0)
  is_active   Boolean                @default(true)
  created_at  DateTime               @default(now())
  updated_at  DateTime               @default(now())
  stores      stores                 @relation(fields: [store_id], references: [id], onDelete: Cascade)
  post_likes  community_post_likes[]

  @@index([store_id])
  @@index([district])
  @@index([type])
  @@index([created_at(sort: Desc)])
  @@schema("public")
}

model community_post_likes {
  id              Int              @id @default(autoincrement())
  post_id         Int
  user_id         Int?
  created_at      DateTime         @default(now())
  community_posts community_posts  @relation(fields: [post_id], references: [id], onDelete: Cascade)
  users           users?           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([post_id, user_id])
  @@index([post_id])
  @@schema("public")
}

model store_partnerships {
  id              Int      @id @default(autoincrement())
  requester_id    Int
  target_id       Int
  status          String   @default("pending")  // pending | accepted | rejected
  message         String?
  created_at      DateTime @default(now())
  updated_at      DateTime @default(now())
  requester_store stores   @relation("partnerships_requester", fields: [requester_id], references: [id], onDelete: Cascade)
  target_store    stores   @relation("partnerships_target",    fields: [target_id],    references: [id], onDelete: Cascade)

  @@unique([requester_id, target_id])
  @@index([requester_id])
  @@index([target_id])
  @@index([status])
  @@schema("public")
}

model phone_otps {
  id         Int      @id @default(autoincrement())
  phone      String
  otp        String
  expires_at DateTime
  verified   Boolean  @default(false)
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([phone], map: "idx_phone_otps_phone")
  @@schema("public")
}

model chat_rooms {
  id             Int             @id @default(autoincrement())
  store_id       Int?
  customer_id    Int?
  customer_phone String?
  type           String          @default("STORE_CUSTOMER") // STORE_CUSTOMER | ADMIN_SUPPORT
  user_id        Int?            // 점주 또는 가입 고객의 user_id
  last_message   String?
  is_active      Boolean?        @default(true)
  created_at     DateTime?       @default(now())
  updated_at     DateTime?       @default(now())
  messages       chat_messages[]
  stores         stores?         @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users?          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([store_id], map: "idx_chat_rooms_store")
  @@index([user_id], map: "idx_chat_rooms_user")
  @@index([type])
  @@schema("public")
}

model chat_messages {
  id           Int        @id @default(autoincrement())
  room_id      Int
  sender_id    Int?
  sender_type  String
  content      String     @db.Text
  message_type String     @default("text") // text | image | system
  is_read      Boolean?   @default(false)
  created_at   DateTime?  @default(now())
  rooms        chat_rooms @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([room_id], map: "idx_chat_messages_room")
  @@schema("public")
}

model shared_cart_items {
  id         Int      @id @default(autoincrement())
  table_id   Int
  product_id Int
  quantity   Int      @default(1)
  user_phone String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade)
  tables     tables   @relation(fields: [table_id], references: [id], onDelete: Cascade)

  @@index([table_id], map: "idx_shared_cart_table")
  @@schema("public")
}

model waiting_list {
  id             Int       @id @default(autoincrement())
  store_id       Int
  customer_name  String?
  customer_phone String
  party_size     Int       @default(1)
  status         String    @default("waiting")
  queue_number   Int
  created_at     DateTime? @default(now())
  updated_at     DateTime? @updatedAt
  called_at      DateTime?
  stores         stores    @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([store_id], map: "idx_waiting_list_store")
  @@index([customer_phone], map: "idx_waiting_list_phone")
  @@schema("public")
}

model reviews {
  id             Int            @id @default(autoincrement())
  store_id       Int
  order_id       Int?           @unique
  customer_name  String?
  customer_phone String?
  rating         Int            @default(5)
  content        String
  image_url      String?
  is_best        Boolean        @default(false)
  reply          String?
  replied_at     DateTime?
  created_at     DateTime?      @default(now())
  updated_at     DateTime?      @updatedAt
  likes          review_likes[]
  orders         orders?        @relation(fields: [order_id], references: [id])
  stores         stores         @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([store_id], map: "idx_reviews_store")
  @@index([created_at], map: "idx_reviews_created")
  @@schema("public")
}

model review_likes {
  id         Int       @id @default(autoincrement())
  review_id  Int
  user_phone String?
  created_at DateTime? @default(now())
  reviews    reviews   @relation(fields: [review_id], references: [id], onDelete: Cascade)

  @@index([review_id], map: "idx_review_likes_id")
  @@schema("public")
}

model store_customers {
  id             Int       @id @default(autoincrement())
  store_id       Int
  customer_name  String?
  customer_phone String
  toss_user_key  String?
  fcm_token      String?   // Firebase Cloud Messaging 토큰 (고객 푸시 알림)
  visit_count    Int       @default(1)
  total_spent    Int       @default(0)
  tier           String    @default("GENERAL")
  last_visit_at  DateTime? @default(now())
  created_at     DateTime? @default(now())
  updated_at     DateTime? @updatedAt
  stores         stores    @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@unique([store_id, customer_phone], name: "uk_store_customer")
  @@index([store_id], map: "idx_store_customers_store")
  @@index([customer_phone], map: "idx_store_customers_phone")
  @@schema("public")
}

model customer_preferences {
  id              Int       @id @default(autoincrement())
  store_id        Int
  customer_phone  String
  preferred_categories  String[]    @default([])  // 선호 카테고리 (한식, 중식, 일식 등)
  preferred_tastes      String[]    @default([])  // 선호 맛 (매운, 달콤, 담백, 짭짤 등)
  spicy_tolerance       Int         @default(1)   // 맵기 선호도 0~3
  price_sensitivity     String      @default("MEDIUM") // LOW/MEDIUM/HIGH
  dietary_restrictions  String[]    @default([])  // 알레르기/식이제한
  favorite_items        Json        @default("[]")  // 즐겨찾기 메뉴 ID 리스트
  order_patterns        Json        @default("{}")  // 주문 패턴 분석 결과 {timeOfDay, dayOfWeek, avgOrderValue, frequency}
  embedding_vector      Bytes?                    // 향후 벡터 검색용 임베딩
  created_at        DateTime? @default(now())
  updated_at        DateTime? @updatedAt

  @@unique([store_id, customer_phone], name: "uk_customer_preferences")
  @@index([store_id], map: "idx_customer_preferences_store")
  @@index([customer_phone], map: "idx_customer_preferences_phone")
  @@schema("public")
}

model store_tier_settings {
  id         Int       @id @default(autoincrement())
  store_id   Int
  tier_name  String
  min_spent  Int       @default(0)
  earn_rate  Float     @default(1.0)
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt
  stores     stores    @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@unique([store_id, tier_name], name: "uk_store_tier")
  @@index([store_id], map: "idx_tier_settings_store")
  @@schema("public")
}

model coupons {
  id               Int            @id @default(autoincrement())
  store_id         Int
  name             String
  type             String
  amount           Int
  min_order_amount Int            @default(0)
  valid_days       Int            @default(30)
  is_active        Int            @default(1)
  created_at       DateTime?      @default(now())
  updated_at       DateTime?      @updatedAt
  stores           stores         @relation(fields: [store_id], references: [id], onDelete: Cascade)
  user_coupons     user_coupons[]
  coupon_issue_history coupon_issue_history[]

  @@index([store_id], map: "idx_coupons_store")
  @@schema("public")
}

model user_coupons {
  id             Int       @id @default(autoincrement())
  customer_phone String
  coupon_id      Int
  status         String    @default("UNUSED")
  used_at        DateTime?
  expires_at     DateTime?
  created_at     DateTime? @default(now())
  updated_at     DateTime? @updatedAt
  coupons        coupons   @relation(fields: [coupon_id], references: [id], onDelete: Cascade)

  @@index([customer_phone], map: "idx_user_coupons_phone")
  @@schema("public")
}

model campaign_settings {
  id           Int       @id @default(autoincrement())
  store_id     Int
  trigger_type String
  target_tier  String?
  coupon_id    Int
  is_active    Int       @default(1)
  created_at   DateTime? @default(now())
  updated_at   DateTime? @updatedAt
  stores       stores    @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([store_id], map: "idx_campaigns_store")
  @@schema("public")
}

model reservations {
  id               Int       @id @default(autoincrement())
  store_id         Int
  customer_name    String
  customer_phone   String
  party_size       Int       @default(2)
  reservation_time DateTime
  status           String    @default("PENDING")
  notes            String?
  created_at       DateTime? @default(now())
  updated_at       DateTime? @updatedAt
  stores           stores    @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([store_id], map: "idx_reservations_store")
  @@index([customer_phone], map: "idx_reservations_phone")
  @@index([reservation_time], map: "idx_reservations_time")
  @@schema("public")
}

model option_templates {
  id          Int       @id @default(autoincrement())
  store_id    Int
  name        String    // 템플릿 이름 (예: 스테이크 굽기, 음료 당도)
  options     String    // JSON 형태의 옵션 목록
  created_at  DateTime? @default(now())
  updated_at  DateTime? @updatedAt
  stores      stores    @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([store_id], map: "idx_option_templates_store")
  @@schema("public")
}

model api_keys {
  id           Int       @id @default(autoincrement())
  store_id     Int
  name         String
  key_prefix   String
  key_hash     String
  scopes       String    @default("read")
  last_used_at DateTime?
  revoked      Boolean   @default(false)
  created_at   DateTime? @default(now())
  stores       stores    @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([store_id], map: "idx_api_keys_store")
  @@schema("public")
}

model webhook_endpoints {
  id         Int       @id @default(autoincrement())
  store_id   Int
  url        String
  secret     String
  events     String    @default("*")
  active     Boolean   @default(true)
  created_at DateTime? @default(now())
  stores     stores    @relation(fields: [store_id], references: [id], onDelete: Cascade)
  deliveries webhook_deliveries[]

  @@index([store_id], map: "idx_webhook_endpoints_store")
  @@schema("public")
}

model notification_templates {
  id         Int      @id @default(autoincrement())
  store_id   Int?
  type       String   // NEW_ORDER | ORDER_STATUS | LOW_STOCK | NEW_REVIEW | NEW_RESERVATION | MANAGER_CALL | SETTLEMENT | SYSTEM
  channel    String   @default("all") // push | socket | alimtalk | all
  title      String
  message    String
  variables  String?  // JSON: 사용 가능한 변수 목록 (e.g. ["orderNumber", "customerName"])
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  stores     stores?  @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([store_id, type], map: "idx_nt_store_type")
  @@index([store_id, is_active], map: "idx_nt_store_active")
  @@schema("public")
}

model webhook_deliveries {
  id              Int       @id @default(autoincrement())
  endpoint_id     Int
  event_type      String
  payload         Json
  status          String    @default("pending")
  attempts        Int       @default(0)
  response_status Int?
  last_error      String?
  created_at      DateTime? @default(now())
  delivered_at    DateTime?
  next_retry_at   DateTime?
  endpoint        webhook_endpoints @relation(fields: [endpoint_id], references: [id], onDelete: Cascade)

  @@index([endpoint_id], map: "idx_webhook_deliveries_endpoint")
  @@index([status, next_retry_at], map: "idx_webhook_deliveries_retry")
  @@schema("public")
}

// ESC/POS 주방 프린트 잡 큐 (온프레미스 브리지가 claim→인쇄→ack)
model print_jobs {
  id          Int       @id @default(autoincrement())
  store_id    Int
  order_id    Int?
  kind        String    @default("kitchen")
  status      String    @default("pending")
  payload_b64 String
  attempts    Int       @default(0)
  error       String?
  claimed_at  DateTime?
  printed_at  DateTime?
  created_at  DateTime  @default(now())
  stores      stores    @relation(fields: [store_id], references: [id], onDelete: Cascade)
  orders      orders?   @relation(fields: [order_id], references: [id], onDelete: SetNull)

  @@index([store_id, status, created_at], map: "idx_print_jobs_claim")
  @@schema("public")
}

// 매장 연동 승인 요청 — 사업자가 공공데이터 매장(super_admin 소유)과 상호·주소가
// 일치할 때 소유권 연동을 요청하고, super_admin 승인 시 매칭된다. (관계 없이 컬럼만)
model store_link_requests {
  id                Int       @id @default(autoincrement())
  user_id           Int       // 요청 사업자
  store_id          Int       // 매칭된 공공 매장
  requested_name    String
  requested_address String?
  status            String    @default("pending") // pending | reviewing | approved | rejected
  admin_note        String?   // 관리자 거부 사유; approve/reject 사용 시에만 작성
  reviewed_by       Int?      // 처리한 관리자 user_id
  created_at        DateTime  @default(now())
  decided_at        DateTime?

  @@index([status])
  @@index([user_id])
  @@index([reviewed_by])
  @@schema("public")
}

// 고객 찜한 매장 — 전화번호 기반 (비회원도 찜 가능)
model store_favorites {
  id              Int      @id @default(autoincrement())
  customer_phone  String
  store_id        Int
  created_at      DateTime @default(now())
  stores          stores   @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@unique([customer_phone, store_id])
  @@index([customer_phone])
  @@schema("public")
}

// 직원 근무표 — 시프트 관리
model staff_schedules {
  id         Int      @id @default(autoincrement())
  staff_id   Int
  store_id   Int
  date       DateTime // 날짜 (시간 제외, @date로 사용)
  start_time String   // "09:00"
  end_time   String   // "18:00"
  role       String?  // staff | kitchen | manager (override)
  note       String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  staff      staff    @relation(fields: [staff_id], references: [id], onDelete: Cascade)
  stores     stores   @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([store_id, date])
  @@index([staff_id, date])
  @@schema("public")
}

model food_trucks {
  id                    Int       @id @default(autoincrement())
  store_id              Int       @unique
  is_active_session     Boolean   @default(false)
  latitude              Float?
  longitude             Float?
  last_gps_updated_at   DateTime?
  geocoded_address      String?
  is_sold_out_emergency Boolean   @default(false)
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  stores                stores    @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([store_id, is_active_session], map: "idx_food_trucks_store_active")
  @@schema("public")
}

model social_accounts {
  id            Int      @id @default(autoincrement())
  user_id       Int?
  provider      String   // kakao | naver | google
  provider_id   String   // provider's unique user ID
  email         String?
  name          String?
  profile_image String?
  access_token  String?  @db.Text
  refresh_token String?  @db.Text
  expires_at    DateTime?
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now())
  users         users?   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_id])
  @@index([user_id])
  @@index([provider])
  @@schema("public")
}

// 관리자 2FA OTP — SMS OTP 기반 2차 인증
model admin_otps {
  id         Int      @id @default(autoincrement())
  user_id    Int
  otp        String
  purpose    String   @default("LOGIN")  // LOGIN | ENABLE | DISABLE
  expires_at DateTime
  verified   Boolean  @default(false)
  used       Boolean  @default(false)
  created_at DateTime @default(now())
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, purpose])
  @@index([user_id, created_at(sort: Desc)])
  @@schema("public")
}

model news {
  id          Int      @id @default(autoincrement())
  title       String
  link        String   @unique
  source      String   // e.g., '소상공인시장진흥공단', '중소벤처기업부', etc.
  category    String?
  summary     String?  @db.Text
  imageUrl    String?  
  publishedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([source])
  @@index([publishedAt(sort: Desc)])
  @@schema("public")
}

// ============================================================
// AI 기반 동적 가격 책정 엔진 (Dynamic Pricing Engine)
// ============================================================

model dynamic_pricing_rules {
  id                 Int       @id @default(autoincrement())
  store_id           Int
  product_id         Int
  rule_name          String
  rule_type          String    // TIME_BASED | DEMAND_BASED | COMPETITOR_BASED | INVENTORY_BASED | WEATHER_BASED
  priority           Int       @default(0)
  is_active          Boolean   @default(true)
  config             Json      // { timeSlots: [], demandThreshold: 0, competitorMargin: 0, inventoryThreshold: 0, weatherConditions: [] }
  min_price          Int       // 최소 가격 (원)
  max_price          Int       // 최대 가격 (원)
  base_price         Int       // 기준 가격 (원)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  stores             stores    @relation(fields: [store_id], references: [id], onDelete: Cascade)
  products           products  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([store_id, product_id], map: "idx_dynamic_pricing_store_product")
  @@index([is_active], map: "idx_dynamic_pricing_active")
  price_logs           dynamic_price_logs[]
  @@schema("public")
}

model dynamic_price_logs {
  id                 Int       @id @default(autoincrement())
  store_id           Int
  product_id         Int
  rule_id            Int?
  old_price          Int
  new_price          Int
  trigger_type       String    // SCHEDULED | DEMAND_SPIKE | INVENTORY_LOW | WEATHER_CHANGE | COMPETITOR_CHANGE | MANUAL
  trigger_data       Json?     // { demandScore: 0.8, inventoryLevel: 5, weather: "rainy", competitorPrice: 3500 }
  ai_reasoning       String?   @db.Text // AI가 생성한 가격 변경 이유
  confidence_score   Float?    // 0.0 ~ 1.0
  applied            Boolean   @default(false)
  applied_at         DateTime?
  created_at         DateTime  @default(now())
  stores             stores    @relation(fields: [store_id], references: [id], onDelete: Cascade)
  products           products  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  rules              dynamic_pricing_rules? @relation(fields: [rule_id], references: [id], onDelete: SetNull)

  @@index([store_id, product_id, created_at(sort: Desc)], map: "idx_dynamic_price_logs_store_product_time")
  @@index([rule_id], map: "idx_dynamic_price_logs_rule")
  @@index([applied], map: "idx_dynamic_price_logs_applied")
  @@schema("public")
}

model competitor_prices {
  id                 Int       @id @default(autoincrement())
  store_id           Int
  product_name       String
  competitor_name    String
  competitor_price   Int
  competitor_url     String?
  last_checked       DateTime  @default(now())
  is_active          Boolean   @default(true)
  stores             stores    @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([store_id, product_name], map: "idx_competitor_prices_store_product")
  @@index([is_active], map: "idx_competitor_prices_active")
  @@schema("public")
}

model customer_segments {
  id                 Int       @id @default(autoincrement())
  store_id           Int
  segment_name       String
  segment_type       String    // FREQUENT, NEW, VIP, PRICE_SENSITIVE, LIKE_NEW, etc.
  segment_description String?
  characteristics    Json      // { avg_order_value: 50000, frequency: 'weekly', preferences: ['coffee', 'pastries'] }
  size              Int       // number of customers in segment
  revenue_contribution Float    // percentage of total revenue
  is_active         Boolean   @default(true)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  stores            stores    @relation(fields: [store_id], references: [id], onDelete: Cascade)

  personalization_analytics personalization_analytics[]
  ai_recommendations      ai_recommendations[]
  customer_personalizations customer_personalizations[]

  @@index([store_id, segment_type], map: "idx_customer_segments_store_type")
  @@index([is_active], map: "idx_customer_segments_active")
  @@schema("public")
}

model customer_personalizations {
  id                 Int       @id @default(autoincrement())
  store_id           Int
  customer_phone    String
  segment_id        Int?
  preferences       Json      // { favorite_categories: ['coffee', 'sandwich'], preferred_times: 'morning' }
  custom_discount   Float    // percentage (e.g., 0.1 = 10% discount)
  special_offers    Json      // array of special offers for this customer
  last_order_date   DateTime?
  lifetime_value     Int      // 총 spending
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  stores            stores    @relation(fields: [store_id], references: [id], onDelete: Cascade)
  segments          customer_segments? @relation(fields: [segment_id], references: [id], onDelete: SetNull)

  @@index([store_id, customer_phone], map: "idx_customer_personalizations_store_phone")
  @@index([segment_id], map: "idx_customer_personalizations_segment")
  @@schema("public")
}

model ai_recommendations {
  id                 Int       @id @default(autoincrement())
  store_id           Int
  customer_phone    String?
  segment_id        Int?
  recommendation_type String    // PRODUCT, COUPON, TIME_SLOT, BUNDLE
  title             String
  description       String
  target_product_ids Json      // array of product ids
  discount_percent  Float?
  valid_from        DateTime
  valid_to          DateTime
  click_through_rate Float   @default(0)
  conversion_rate    Float   @default(0)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  stores            stores    @relation(fields: [store_id], references: [id], onDelete: Cascade)
  segments          customer_segments? @relation(fields: [segment_id], references: [id], onDelete: SetNull)

  @@index([store_id, recommendation_type], map: "idx_ai_recommendations_store_type")
  @@index([created_at(sort: Desc)], map: "idx_ai_recommendations_created")
  @@schema("public")
}

model personalization_analytics {
  id                 Int       @id @default(autoincrement())
  store_id           Int
  segment_id        Int?
  date              DateTime
  impressions        Int       @default(0)
  click_throughs    Int       @default(0)
  conversions        Int       @default(0)
  revenue_from_segment Int     @default(0)
  avg_order_value    Int
  created_at        DateTime  @default(now())
  stores            stores    @relation(fields: [store_id], references: [id], onDelete: Cascade)
  segments          customer_segments? @relation(fields: [segment_id], references: [id], onDelete: SetNull)

  @@unique([store_id, segment_id, date])
  @@index([store_id, date(sort: Desc)], map: "idx_personalization_analytics_store_date")
  @@schema("public")
}

model demand_forecasts {
  id                 Int       @id @default(autoincrement())
  store_id           Int
  product_id         Int
  forecast_date      DateTime
  predicted_demand   Int       // 예측 주문 수량
  confidence_score   Float     // 0.0 ~ 1.0
  factors            Json      // { weather: "sunny", dayOfWeek: 5, holiday: false, events: [] }
  model_version      String    // "v1.0-gemini"
  created_at         DateTime  @default(now())
  stores             stores    @relation(fields: [store_id], references: [id], onDelete: Cascade)
  products           products  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([store_id, product_id, forecast_date], map: "uq_demand_forecast_store_product_date")
  @@index([store_id, forecast_date], map: "idx_demand_forecast_store_date")
  @@schema("public")
}

// ── 슈퍼관리자 지급/발급 템플릿 ─────────────────────────────────────
model grant_templates {
  id         Int       @id @default(autoincrement())
  store_id   Int?
  title      String
  reason     String
  is_auto    Boolean   @default(false)
  is_active  Boolean   @default(true)
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt
  stores     stores?   @relation(fields: [store_id], references: [id], onDelete: Cascade)
  point_grant_history point_grant_history[]
  coupon_issue_history coupon_issue_history[]

  @@index([store_id], map: "idx_grant_templates_store")
  @@index([is_auto], map: "idx_grant_templates_auto")
  @@schema("public")
}

// ── 권한설정 변경 이력 ─────────────────────────────────────────────
model grant_change_logs {
  id           Int       @id @default(autoincrement())
  store_id     Int
  admin_id     Int
  grant_type   String
  changed_field String
  old_value    String?
  new_value    String?
  created_at   DateTime? @default(now())
  stores       stores    @relation(fields: [store_id], references: [id], onDelete: Cascade)
  admin        users     @relation(fields: [admin_id], references: [id])

  @@index([store_id], map: "idx_grant_change_logs_store")
  @@index([created_at(sort: Desc)], map: "idx_grant_change_logs_time")
  @@schema("public")
}

// ── 슈퍼관리자 포인트 지급 이력 ───────────────────────────────────
model point_grant_history {
  id            Int       @id @default(autoincrement())
  store_id      Int
  admin_id      Int
  target_phone  String
  amount        Int
  balance_before Int?
  balance_after Int?
  reason        String?
  batch_id      String?
  template_id   Int?
  created_at    DateTime? @default(now())
  stores        stores    @relation(fields: [store_id], references: [id], onDelete: Cascade)
  admin         users     @relation(fields: [admin_id], references: [id])
  template      grant_templates? @relation(fields: [template_id], references: [id])

  @@index([store_id], map: "idx_point_grant_history_store")
  @@index([admin_id], map: "idx_point_grant_history_admin")
  @@index([created_at(sort: Desc)], map: "idx_point_grant_history_time")
  @@index([batch_id], map: "idx_point_grant_history_batch")
  @@schema("public")
}

// ── 슈퍼관리자 쿠폰 발급 이력 ─────────────────────────────────────
model coupon_issue_history {
  id            Int       @id @default(autoincrement())
  store_id      Int
  admin_id      Int
  coupon_id     Int
  target_phone  String
  user_coupon_id Int?
  batch_id      String?
  template_id   Int?
  created_at    DateTime? @default(now())
  stores        stores    @relation(fields: [store_id], references: [id], onDelete: Cascade)
  admin         users     @relation(fields: [admin_id], references: [id])
  coupons       coupons   @relation(fields: [coupon_id], references: [id])
  template      grant_templates? @relation(fields: [template_id], references: [id])

  @@index([store_id], map: "idx_coupon_issue_history_store")
  @@index([admin_id], map: "idx_coupon_issue_history_admin")
  @@index([created_at(sort: Desc)], map: "idx_coupon_issue_history_time")
  @@index([batch_id], map: "idx_coupon_issue_history_batch")
  @@schema("public")
}

model pricing_optimization_jobs {
  id                 Int       @id @default(autoincrement())
  store_id           Int
  status             String    @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED
  job_type           String    // FULL_OPTIMIZATION | INCREMENTAL_UPDATE | DEMAND_FORECAST | COMPETITOR_SYNC
  started_at         DateTime?
  completed_at       DateTime?
  error_message      String?   @db.Text
  result_summary     Json?     // { rulesUpdated: 10, pricesChanged: 5, forecastGenerated: 50 }
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  stores             stores    @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([store_id, status], map: "idx_pricing_jobs_store_status")
  @@index([created_at(sort: Desc)], map: "idx_pricing_jobs_created")
  @@schema("public")
}

// ── AI 추천 노출/클릭/전환 추적 ─────────────────────────────────────
model recommendation_impressions {
  id              String    @id @default(cuid())
  store_id        Int
  session_id      String    // 세션/방문자 식별자
  user_id         Int?      // 로그인한 사용자인 경우
  phone           String?   // 비회원 식별용
  menu_id         Int       // 추천된 메뉴 ID
  recommendation_type String  // ai_personalized | tinkerbell | pairing | dessert | trending
  source          String    // menu_page | tinkerbell | cart | kiosk | qr
  position        Int       // 추천 목록에서의 순서 (0-based)
  weather_context Json?     // 당시 날씨 컨텍스트 스냅샷
  time_period     String?   // 아침/점심/저녁/야식 등
  created_at      DateTime  @default(now())

  @@index([store_id, created_at], map: "idx_rec_imp_store_time")
  @@index([session_id], map: "idx_rec_imp_session")
  @@index([menu_id], map: "idx_rec_imp_menu")
  @@index([recommendation_type], map: "idx_rec_imp_type")
  @@schema("public")
}

model recommendation_clicks {
  id                String   @id @default(cuid())
  impression_id     String   @unique(map: "uq_rec_click_impression")
  store_id          Int
  session_id        String
  user_id           Int?
  phone             String?
  menu_id           Int
  recommendation_type String
  time_to_click_ms  Int?     // 노출 후 클릭까지 걸린 시간
  created_at        DateTime @default(now())

  @@index([store_id, created_at], map: "idx_rec_click_store_time")
  @@index([impression_id], map: "idx_rec_click_imp")
  @@schema("public")
}

model recommendation_conversions {
  id                    String   @id @default(cuid())
  impression_id         String?  // 연결된 노출 (있는 경우)
  click_id              String?  // 연결된 클릭 (있는 경우)
  store_id              Int
  session_id            String
  user_id               Int?
  phone                 String?
  order_id              Int      // 전환된 주문 ID
  menu_id               Int      // 주문된 메뉴 ID (추천된 메뉴와 다를 수 있음)
  recommendation_type   String
  conversion_value      Int      // 주문 금액
  quantity              Int      @default(1)
  time_to_conversion_ms BigInt?  // 노출/클릭 후 주문까지 걸린 시간
  attributed            Boolean  @default(true)  // 어트리뷰션 인정 여부
  created_at            DateTime @default(now())

  @@index([store_id, created_at], map: "idx_rec_conv_store_time")
  @@index([session_id], map: "idx_rec_conv_session")
  @@index([order_id], map: "idx_rec_conv_order")
  @@index([menu_id], map: "idx_rec_conv_menu")
  @@schema("public")
}

// ── 추천 성과 일일 집계 (대시보드용) ────────────────────────────────
model recommendation_daily_stats {
  id                  String   @id @default(cuid())
  store_id            Int
  date                DateTime @db.Date
  recommendation_type String
  impressions         Int      @default(0)
  clicks              Int      @default(0)
  conversions         Int      @default(0)
  revenue             Int      @default(0)
  ctr                 Float    @default(0)  // Click Through Rate
  cvr                 Float    @default(0)  // Conversion Rate
  avg_order_value     Float    @default(0)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@unique([store_id, date, recommendation_type], map: "uq_rec_daily_stats")
  @@index([store_id, date], map: "idx_rec_daily_store_date")
  @@schema("public")
}

// Eco Badge fields (added via migration)
