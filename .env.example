# ============================================================
# WeMarket 환경변수 설정 예시
# - .env 파일로 복사하여 사용하세요: cp .env.example .env
# - 실제 시크릿 값은 절대 커밋하지 마세요
# ============================================================

# ---------- Database ----------
DATABASE_URL="postgresql://user:password@host:5432/wemarket"
DIRECT_URL="postgresql://user:password@host:5432/wemarket?schema=public"

# ---------- JWT (인증) ----------
# 최소 32자 이상의 랜덤 문자열 사용 (openssl rand -hex 32)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-another-long-random-string"

# ---------- SMS (Coolsms) ----------
SMS_ENV=coolsms
SMS_API_KEY="YOUR_COOLSMS_API_KEY"
SMS_API_SECRET="YOUR_COOLSMS_API_SECRET"
SMS_SENDER="01012345678"

# ---------- AI (Gemini) ----------
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ---------- Naver Local Search API (매장 정보 보강) ----------
# developers.naver.com/apps → 비로그인 오픈 API (지역검색)
NAVER_CLIENT_ID="YOUR_NAVER_CLIENT_ID"
NAVER_CLIENT_SECRET="YOUR_NAVER_CLIENT_SECRET"

# ---------- Naver Cloud Platform Geocoding (대안 지오코딩) ----------
# map.naver.com → AI·API → Maps → 인증정보
NCP_GEOCODE_KEY_ID="YOUR_NCP_KEY_ID"
NCP_GEOCODE_KEY="YOUR_NCP_KEY"

# ---------- Toss Payments ----------
TOSS_CLIENT_KEY="YOUR_TOSS_CLIENT_KEY"
TOSS_SECRET_KEY="YOUR_TOSS_SECRET_KEY"

# ---------- Firebase Cloud Messaging (FCM) ----------
FIREBASE_SERVICE_ACCOUNT_PATH="./config/firebase-service-account.json"
FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"
FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"

# ---------- Server ----------
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=https://toss.wemarket.workers.dev
BACKEND_URL=https://wemarket-toss.onrender.com
# BYPASS_OTP=true  # 개발 중 OTP 인증 없이 회원가입 허용
# USE_HTTPONLY_COOKIE=true  # JWT를 HttpOnly Cookie로 전송 (보안 강화, 로컬스토리지 대체)

# ---------- Frontend (Vite) ----------
# frontend/.env 파일에 설정
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
