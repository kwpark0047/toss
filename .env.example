# ============================================================
# WeMarket 환경변수 설정 예시
# - .env 파일로 복사하여 사용하세요: cp .env.example .env
# - 실제 시크릿 값은 절대 커밋하지 마세요
# - 필수(REQUIRED): 서버 시작에 반드시 필요한 값
# - 옵션(OPTIONAL): 없으면 기능 일부 비활성화
# ============================================================

# ── 1. SERVER: 런타임 환경 ──────────────────────────────────
NODE_ENV=development            # (REQUIRED) development | production | test
PORT=5000                       # (OPTIONAL) 서버 포트 (기본 5000)
CORS_ORIGIN=http://localhost:3000  # (REQUIRED) 허용할 CORS 오리진 (콤마 구분 다중 가능, 정확 일치)
# CORS_PREVIEW_SUFFIXES=preview.example.com  # (OPTIONAL) 하위 도메인 프리뷰까지 허용할 호스트
#   주의: *.pages.dev / *.vercel.app 전체 와일드카드 허용은 제거되었다(C-3).
#   프리뷰 배포가 필요하면 소유한 프로젝트 호스트만 여기에 명시할 것.
FRONTEND_URL=https://toss.wemarket.workers.dev  # (OPTIONAL) 프론트엔드 배포 주소
BACKEND_URL=https://wemarket-toss.onrender.com   # (OPTIONAL) 백엔드 배포 주소
# BYPASS_OTP=true                # (개발용) OTP 인증 없이 회원가입 허용
# USE_HTTPONLY_COOKIE=true       # (보안) JWT를 HttpOnly Cookie로 전송
# COOKIE_CROSS_SITE=true         # (기본 true) 프론트/백엔드가 다른 도메인이면 유지.
#                                #   같은 도메인 reverse proxy 이면 false 로 낮춘다.
#                                #   cross-site(true) 는 SameSite=None+Secure 로 고정된다.
# ENABLE_DEV_OPS=true           # (보안) /api/_devops 운영 편의 엔드포인트 활성화
# LOG_DIR=./logs                 # (OPTIONAL) 로그 파일 저장 경로

# ── 2. DATABASE: PostgreSQL (Prisma) ────────────────────────
# (REQUIRED) Supabase 또는托管 PostgreSQL 연결 문자열
DATABASE_URL="postgresql://user:password@host:5432/wemarket"
# (REQUIRED) Supabase Transaction Pooler 우회용 직접 연결
DIRECT_URL="postgresql://user:password@host:5432/wemarket?schema=public"

# ── 3. AUTHENTICATION: JWT + 2FA ────────────────────────────
# (REQUIRED) 최소 32자 이상 랜덤 문자열 (openssl rand -hex 32)
JWT_SECRET="change-me-to-a-long-random-string"
# (REQUIRED) JWT와 다른 문자열 사용 권장
JWT_REFRESH_SECRET="change-me-to-another-long-random-string"
# (OPTIONAL) 전화번호 암호화 키 (없으면 암호화 비활성화)
# PHONE_ENC_KEY="change-me-to-a-32-char-key"

# ── 4. SMS: Coolsms (알림톡 + OTP 발송) ────────────────────
# (REQUIRED) coolsms | dev (dev는 실제 발송 없이 로그만)
SMS_ENV=coolsms
SMS_API_KEY="YOUR_COOLSMS_API_KEY"       # (REQUIRED if SMS_ENV=coolsms)
SMS_API_SECRET="YOUR_COOLSMS_API_SECRET" # (REQUIRED if SMS_ENV=coolsms)
SMS_SENDER="01012345678"                 # (REQUIRED) 발신번호 (coolsms 등록 필요)

# ── 5. AI: Google Gemini ────────────────────────────────────
# (OPTIONAL) AI 메뉴 추천/번역/분석 기능 사용 시 필요
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
# (OPTIONAL) AI 메뉴 이미지 생성용 Unsplash (generateMenuImage)
# UNSPLASH_ACCESS_KEY="YOUR_UNSPLASH_KEY"

# ── 6. EXTERNAL APIs ────────────────────────────────────────
# Naver Local Search — (OPTIONAL) 매장 정보 보강
# developers.naver.com/apps → 비로그인 오픈 API (지역검색)
NAVER_CLIENT_ID="YOUR_NAVER_CLIENT_ID"
NAVER_CLIENT_SECRET="YOUR_NAVER_CLIENT_SECRET"

# Naver Cloud Geocoding — (OPTIONAL) 주소→좌표 변환
# map.naver.com → AI·API → Maps → 인증정보
NCP_GEOCODE_KEY_ID="YOUR_NCP_KEY_ID"
NCP_GEOCODE_KEY="YOUR_NCP_KEY"

# ── 7. PAYMENTS: Toss ───────────────────────────────────────
# (REQUIRED) 토스페이먼츠 연동
TOSS_CLIENT_KEY="YOUR_TOSS_CLIENT_KEY"   # (REQUIRED) 클라이언트 (프론트엔드 노출 가능)
TOSS_SECRET_KEY="YOUR_TOSS_SECRET_KEY"   # (REQUIRED) 시크릿 (절대 노출 금지)

# ── 8. PUSH: Firebase Cloud Messaging ───────────────────────
# (OPTIONAL) FCM 푸시 알림 기능 사용 시 필요
# firebase-admin v14 모듈러 API 사용. 아래 둘 중 하나만 설정하면 된다.
#   1) FIREBASE_SERVICE_ACCOUNT_JSON — 서비스 계정 JSON 문자열 (컨테이너 환경 권장)
#   2) FIREBASE_SERVICE_ACCOUNT_PATH — 서비스 계정 파일 경로
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account", ...}'
FIREBASE_SERVICE_ACCOUNT_PATH="./config/firebase-service-account.json"
FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"
FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"

# ── 8-1. STORAGE: 업로드 파일 저장소 ─────────────────────────
# local  : public/uploads 디스크 저장 (개발용)
# supabase: Supabase Storage (운영 권장 — Render 등은 재배포 시 디스크가 초기화된다)
STORAGE_DRIVER=local
# SUPABASE_URL="https://<project>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="<service_role key>"   # 서버 전용, 절대 클라이언트 노출 금지
# SUPABASE_STORAGE_BUCKET="uploads"                # 기본값 uploads (공개 버킷으로 생성할 것)

# ── 9. MONITORING: Sentry + Alert + Report ──────────────────
# (OPTIONAL) 비우면 Sentry 비활성화
SENTRY_DSN="YOUR_SENTRY_DSN_HERE"
# (OPTIONAL) 슬랙 웹훅 — 헬스체크 이상·RateLimit 초과 알림
# ALERT_WEBHOOK_URL="https://hooks.slack.com/services/..."
# (OPTIONAL) 주간/월간 리포트 이메일 발송 (웹훅 방식, SendGrid/Mailgun 등)
# REPORT_EMAIL_WEBHOOK_URL="https://api.sendgrid.com/v3/mail/send"
# REPORT_EMAIL_TO="admin@wemarket.com"

# ── 10. REDIS: 캐싱, 세션, 큐 ────────────────────────────────
# (OPTIONAL) 없으면 NodeCache 인메모리로 폴백
REDIS_URL="redis://localhost:6379"

# ── 11. FRONTEND (Vite) ─────────────────────────────────────
# frontend/.env 파일에 설정 (Vite는 VITE_ 프리픽스 필수)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
# VITE_API_URL="https://wemarket-toss.onrender.com/api"  # (OPTIONAL) API URL 오버라이드
# VITE_HTTPONLY_COOKIE=true           # HttpOnly Cookie 모드 (백엔드와 일치)
# VITE_KAKAO_JS_KEY="YOUR_KAKAO_JS_KEY"           # (OPTIONAL) Kakao 로그인 SDK
# VITE_NAVER_CLIENT_ID="YOUR_NAVER_CLIENT_ID"     # (OPTIONAL) Naver 로그인
# VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"   # (OPTIONAL) Google 로그인

# ── 11. DEPLOY: Seed Key ────────────────────────────────────
# (OPTIONAL) SEED_KEY 설정 시 /api/_devops/seed 로 시드 실행 가능
# SEED_KEY="your-seed-key"
