{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toss",
  "main": "frontend/worker.js",
  "compatibility_date": "2025-08-01",
  "assets": {
    "directory": "frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
